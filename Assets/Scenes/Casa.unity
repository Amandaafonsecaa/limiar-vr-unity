  successLines:
  - text: Meu caderno?
    duration: 2
  - text: "Eu n\xE3o lembro de ter deixado isso aqui."
    duration: 3
  - text: Ele devia estar no meu quarto.
    duration: 2.6
  - text: Espera...
    duration: 1.8
  - text: "Isso veio do quarto da minha m\xE3e?"
    duration: 3
  - text: "Eu preciso ir l\xE1."
    duration: 2.2
  lockedLines:
  - text: "Ainda n\xE3o..."
    duration: 2
  - text: Tem alguma coisa que eu preciso lembrar primeiro.
    duration: 3
  fadeDuration: 0.25
  delayBetweenLines: 0.2
