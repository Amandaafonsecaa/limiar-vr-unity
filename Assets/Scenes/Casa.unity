  captionCanvas: {fileID: 245184895}
  captionCanvasGroup: {fileID: 245184897}
  captionText: {fileID: 12249876}
  lines:
  - text: "Eu t\xF4 em casa?"
    duration: 2.2
  - text: Meu Deus... aquela palestra sobre sono estava certa?
    duration: 3.2
  - text: E o elevador?
    duration: 1.8
  - text: Isso aconteceu mesmo?
    duration: 2
  - text: "Imposs\xEDvel eu ter ca\xEDdo daquele jeito... e estar bem."
    duration: 3.4
  - text: "Preciso entender onde eu t\xF4."
    duration: 2.4
  delayBeforeStart: 0.5
  fadeDuration: 0.25
  delayBetweenLines: 0.2
  playerTag: Player
