  captionLines:
  - text: Um atestado...
    duration: 2
  - text: "Minha m\xE3e teve que parar de trabalhar."
    duration: 3
  - text: Eu lembro da casa ficando mais silenciosa depois disso.
    duration: 3.5
  - text: "A gente come\xE7ou a cortar tudo."
    duration: 2.8
  - text: "At\xE9 a \xE1gua quente.\n"
    duration: 2.4
  fadeDuration: 0.25
  delayBetweenLines: 0.2
