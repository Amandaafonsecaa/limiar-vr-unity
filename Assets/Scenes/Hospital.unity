    - target: {fileID: 919132149155446097, guid: b6a2a4ab29b32487ab2d737c346d7a4d, type: 3}
      propertyPath: m_Name
      value: "monstro-paradousing UnityEngine;  public class MonstroOrbitalComSom
        : MonoBehaviour {     [Header(\"Alvo (Arraste o XROrigin ou Main Camera aqui)\")]    
        public Transform jogador;       [Header(\"Configura\xE7\xF5es do Carrossel\")]    
        public float velocidadeGiro = 25f;    // Velocidade da rota\xE7\xE3o    
        public float distanciaDoJogador = 2.5f; // \"Razoavelmente perto\" (raio
        do c\xEDrculo)      [Header(\"\xC1udio Longo (Falas com Pausas)\")]     public
        AudioSource audioFalasLongas; // Arraste o AudioSource com o MP3 aqui     
        private Animator animator;      void Start()     {         animator = GetComponent<Animator>();         
        // Tenta achar a c\xE2mera VR se voc\xEA esquecer de arrastar no Inspector        
        if (jogador == null && Camera.main != null)         {             jogador
        = Camera.main.transform;         }          // Garante que o monstro comece
        a andar (Base Layer ou camada configurada)         if (animator != null)        
        {             animator.SetBool(\"isWalking\", true);         }          //
        SOLTA AS FALAS: D\xE1 o play no MP3 longo logo no in\xEDcio do comportamento        
        if (audioFalasLongas != null)         {             audioFalasLongas.loop
        = true; // Deixa em loop para o \xE1udio recome\xE7ar se a persegui\xE7\xE3o
        demorar             audioFalasLongas.Play();         }     }      void Update()    
        {         if (jogador == null) return;          // 1. Faz o monstro girar
        fisicamente ao redor da posi\xE7\xE3o do jogador VR         transform.RotateAround(jogador.position,
        Vector3.up, velocidadeGiro * Time.deltaTime);          // 2. Garante que
        a dist\xE2ncia dele at\xE9 o jogador fique travada no raio que voc\xEA escolheu        
        Vector3 direcao = (transform.position - jogador.position).normalized;        
        transform.position = jogador.position + direcao * distanciaDoJogador;         
        // 3. Faz o monstro ficar sempre olhando de frente para os olhos do jogador
        enquanto orbita         Vector3 posicaoOlhar = new Vector3(jogador.position.x,
        transform.position.y, jogador.position.z);         transform.LookAt(posicaoOlhar);    
        } }"
      objectReference: {fileID: 0}
